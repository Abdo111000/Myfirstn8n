FROM n8nio/n8n:latest

USER root

# 1. تحديث إجباري لمكتبات التشفير للإصدار السليم (لسد الثغرة)
RUN apk update && \
    apk add --no-cache --upgrade libcrypto3 libssl3 openssl

# 2. ضبط الصلاحيات للمستخدم 10014 (عشان Choreo يرضى)
RUN chown -R 10014:10014 /home/node

ENV HOME=/home/node

# 3. تشغيل المستخدم
USER 10014
